# Email / IMAP Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_CHAT_ID=12345678

# SMS Configuration
SMS_SOURCE=file  # Options: 'file' or 'twilio'
SMS_FILE_PATH=data/sms.txt  # Path to SMS file if using file source
TWILIO_ACCOUNT_SID=your_twilio_account_sid  # Required if using twilio source
TWILIO_AUTH_TOKEN=your_twilio_auth_token  # Required if using twilio source
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# Application Settings
LOG_LEVEL=INFO
REPORT_DAILY=true
REPORT_WEEKLY=true
SUBJECT_KEYWORDS=MoMo,Debit Alert,Credit Alert,Transaction Alert

# Database (PostgreSQL required)
DATABASE_URL=postgresql://user:pass@localhost:5432/finance
